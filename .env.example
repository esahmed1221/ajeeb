# Docker Compose / server
# Copy this file to .env, then replace every value beginning with "replace-with".
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
SITE_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=replace-with-at-least-16-characters
# Existing installations may set ADMIN_PASSWORD_B64 instead of ADMIN_PASSWORD.
# ADMIN_PASSWORD_B64=
SESSION_SECRET=replace-with-at-least-48-random-characters
# Create the bot with @BotFather. Keep this token secret and never commit it.
TELEGRAM_BOT_TOKEN=

# Docker PostgreSQL. Use a long random value made of letters and numbers.
POSTGRES_DB=ajeeb
POSTGRES_USER=ajeeb
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Outside Docker, leave DATABASE_URL unset to use the embedded local database.
# Set it to connect to any external PostgreSQL server.
# DATABASE_URL=postgresql://ajeeb:change-me@127.0.0.1:5432/ajeeb
DATABASE_POOL_SIZE=10


# Emergency/development fallback only:
# STORAGE_DRIVER=json

# Set to require when the database provider requires TLS.
# DATABASE_SSL=require
# Keep certificate verification enabled. Use 0 only if your provider explicitly requires it.
# DATABASE_SSL_REJECT_UNAUTHORIZED=1
